# WuBuNOS Test Gauntlet — .gitignore

# Ignore upstream repo clones (huge, tracked by their own git)
test_gauntlet/depot/fujitsu/upstream/
test_gauntlet/depot/c-testsuite/upstream/
test_gauntlet/depot/writing-c-compiler/upstream/

# Ignore build artifacts
*.o
*.a
*.so
gauntlet_runner
gauntlet_v2
gauntlet_v3
gauntlet_direct
gauntlet_output
test_single
test_gauntlet_output

# Ignore logs
*.log
/tmp/gv*.log
/tmp/gv3_*
/tmp/gauntlet_*

# Ignore OS files
.DS_Store
*~
test_gauntlet/depot/writing-c-compiler/upstream/
test_gauntlet/depot/incremental/upstream/
test_gauntlet/depot/8cc/upstream/
test_gauntlet/depot/compcert/upstream/
test_gauntlet/depot/csmith/upstream/
